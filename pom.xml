<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.bupt</groupId>
    <artifactId>mock-interview-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mock-interview-agent</name>
    <description>本地运行的 AI 模拟面试官：贴 JD → 解析考点 → 角色追问 → Critic 报告 + 错题本</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- ⚠️ 必须显式覆盖：Spring Boot 3.3.5 管理的 Lombok 1.18.34 在 JDK 24 下注解处理器
             静默失效（domain 实体的 getter/setter 全部不生成，编译不报错、极隐蔽，2026-09-18 踩坑）。
             三道保险：① Lombok 升 1.18.48（支持 JDK 17/21/24，IDE 用高版本 JDK 也不会失效）；
             ② 命令行构建用 JDK 21 跑 Maven——mvnw.cmd 在未显式设置 JAVA_HOME 时自动选
             %USERPROFILE%\jdk-21，无需每次手动 set；③ maven-enforcer-plugin 显式拒绝 JDK 24+，
             把静默失效变成构建期硬报错。
             产物字节码仍是 Java 17（java.version=17 → release 17），已用 javap 验证 major=61。 -->
        <lombok.version>1.18.48</lombok.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    </properties>

    <dependencies>
        <!-- Web（含 SSE：用 ResponseEntity<SseEmitter> 即可） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验（后续接口入参校验用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- T9 前端：Thymeleaf 服务端渲染（决策 #12：不引入 npm / 任何前端构建链）。
             只用它做页面骨架，交互逻辑全在 static/app.js（原生 JS + EventSource 收 SSE）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- 配置处理器（yml 提示，可省） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- T2：持久化（domain.md §2 全部实体落 MySQL 8；T3 才建 Entity） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- T2 验证兜底：H2 内存库，Docker 罢工时用 h2 profile 免外部依赖启动（生产走 MySQL，默认 profile 不变） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- T2：Redis（指纹去重 / 会话缓存；MVP 不引 RabbitMQ，决策 #11） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- T5 调 LLM 统一用 OkHttp：单例 OkHttpClient + 单 ConnectionPool；不引 JDK HttpClient（决策 2026-09-17） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>

        <!-- Lombok：实体省 getter/setter 样板（T3 引入；纯构建期代码生成，非运行时依赖，可移除） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- R1-1：JWT 令牌（0.12.x，io.jsonwebtoken 新版本）。
             三个包一起引：api 是接口、impl 是实现、jackson 是 JSON 序列化（jjwt 用 Jackson 处理 claims）。 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- R1-1：密码 BCrypt 加密（只用 crypto 模块，不引完整 Spring Security Web） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- R4：向量持久化（Lucene FSDirectory + HNSW）+ L3 对比实验共用。
             选型 2026-09-18：FAISS 的 Java 绑定不在 Maven Central（bytedeco 无 faiss 预设；
             karellen/faiss-java、jelmerk/faiss4j 均 404），只能走 JitPack 且实测 401 拒绝。
             改用 Lucene HNSW：同属 ANN 算法族，纯 Java / 零原生库 / 零 JitPack，
             是 OpenSearch / Elasticsearch 使用的同一套向量检索实现。 -->
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-core</artifactId>
            <version>9.12.3</version>
        </dependency>
        <!-- IndexWriterConfig() 默认用 StandardAnalyzer，它不在 lucene-core 而在本模块，需显式引入 -->
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-analysis-common</artifactId>
            <version>9.12.3</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 卡构建 JDK：允许 17-23（本机实际用 21），JDK 24+ 直接失败。
                 不依赖 Lombok 是否兼容——把"选错 JDK 但编译看起来正常"在构建期拦死。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-jdk</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,24)</version>
                                    <message>
BUILD JDK NOT ALLOWED: this project requires JDK 17-23 to build Maven (fixed JDK 21 on this machine: C:\Users\19284\jdk-21).
JDK 24+ is rejected because Lombok annotation processing silently failed there (getters/setters not generated, no compile error).
Fix: open a NEW PowerShell and run mvnw.cmd directly (it auto-picks %USERPROFILE%\jdk-21 when JAVA_HOME is unset),
or set $env:JAVA_HOME="C:\Users\19284\jdk-21" explicitly.
Note: java.version=17 is the bytecode TARGET (major version 61); you do NOT need to install JDK 17.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
