# ============ 备案期间：用 IP 直接访问（HTTP，无需域名/证书）============
# 此时 .env 里 DOMAIN 留空即可，Caddy 只监听 80。
#
# 安全说明（R2-T0）：本文件刻意不配置 log 指令——Caddy 2 默认不输出 access log，
# 因此 SSE 请求 URL 中的 ?jwt= 查询参数不会被反代落盘；如未来开启 access log，
# 必须配合 log 输出的 uri 脱敏（或改走 header 传 token），禁止原样记录 query。
:80 {
    encode gzip
    reverse_proxy app:8080
}

# ============ 备案完成后切换 ============
# 1) 把 .env 里的 DOMAIN / ACME_EMAIL 填好（DOMAIN 的 A 记录已指向服务器公网 IP）
# 2) 注释掉上面的 :80 块，取消下面块的注释
# 3) 重启 caddy：docker compose -f docker-compose.prod.yml restart caddy
# Caddy 会自动向 Let's Encrypt 申请并续期 HTTPS 证书。
# {$DOMAIN} {
#     encode gzip
#     reverse_proxy app:8080
# }
