# ===== 必填 =====
# MySQL root 密码（强密码：>=12 位，含大小写+数字+符号）
MYSQL_PASSWORD=change_me_strong_password

# 大模型密钥（R1-3 后已从保险箱删除，仅走环境变量）
DEEPSEEK_API_KEY=sk-xxxx
DASHSCOPE_API_KEY=sk-xxxx

# 生产必须显式设，否则重启后旧 JWT 全部失效、BYOK 密文不可解。
# 生成命令（服务器或本机均可）：
#   JWT_SECRET : openssl rand -base64 48
#   APP_DATA_KEY: openssl rand -base64 32
JWT_SECRET=请替换为 openssl rand -base64 48 的输出
APP_DATA_KEY=请替换为 openssl rand -base64 32 的输出

# ===== Caddy / 域名 =====
# 有域名时填你的域名（且 A 记录已指向服务器公网 IP）；无域名改用 IP 测试时留空，
# 并把 Caddyfile 里的 {env.DOMAIN} 块注释掉、启用 :80 块。
DOMAIN=your-domain.example.com
ACME_EMAIL=admin@your-domain.example.com

# ===== 可选：仅 2核2G 小内存机器需要调小；4G 机器保持注释 =====
# JAVA_TOOL_OPTIONS=-Xmx512m -Xms256m -XX:+UseG1GC
